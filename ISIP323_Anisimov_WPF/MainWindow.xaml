<Window x:Class="ISIP323_Anisimov_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP323_Anisimov_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="5">
       
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="55*"/>
            <RowDefinition Height="30*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>
        
        <Button Content="НАЧАТЬ" FontSize="30" Grid.RowSpan="4" Grid.ColumnSpan="2" Panel.ZIndex="1" Click="Button_Click" x:Name="StartButton"/>
        <Label Content="Игра виагра" HorizontalAlignment="Center" FontSize="20" Grid.ColumnSpan="2"/>

        <Grid x:Name="TopInterface" Grid.Row="1" Grid.ColumnSpan="2">
            <TextBlock Text="Этаж: {0}" FontSize="15" HorizontalAlignment="Left" x:Name="CurrentTurn"/>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="HP " />
                <ProgressBar x:Name="HPProgressBar" Maximum="100" Minimum="0" Value="10" Height="15" Width="200" Foreground="Red" />
                <TextBlock x:Name="HPTextBlock" Text="{Binding HP}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" x:Name="MainFrame">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListBox x:Name="EnemyListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="0" SelectionChanged="EnemyListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Image  Width="50" Height="50" Source="{Binding ImagePath}"/>
                            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"/>
                            <TextBlock  Text="{Binding MaxHP}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Grid.Row="1">
                <Button x:Name="Attack" Content="Attack" FontSize="30" Background="Red" Click="Attack_Click"/>
                <Button x:Name="Defend" Content="Defend" FontSize="30" Background="Blue" Click="Defend_Click"/>
            </StackPanel>
            <Image Source="{Binding ImagePath}" x:Name="ImageEnemy" Grid.Column="1"/>
        </Grid>


        <Grid Grid.Row="3" >
            <TextBlock HorizontalAlignment="Left" Text="{Binding Armor.Name}" FontSize="22" VerticalAlignment="Center" x:Name="Armor"/>
            <TextBlock HorizontalAlignment="Right" Text="{Binding Weapon.Name}" FontSize="22" VerticalAlignment="Center" x:Name="Weapon"/>
        </Grid>


        <ListView Grid.Row="3" Grid.Column="1" x:Name="Logs" >


            <ListView.ItemTemplate>
                <DataTemplate>

                    <TextBlock Text="{Binding}"/>

                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
