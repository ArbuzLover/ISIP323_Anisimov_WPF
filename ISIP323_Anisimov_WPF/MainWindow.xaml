<Window x:Class="ISIP323_Anisimov_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP323_Anisimov_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="55*"/>
            <RowDefinition Height="30*"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>
        
        <Label Content="Игра виагра" HorizontalAlignment="Center" FontSize="20" Grid.ColumnSpan="2"/>

        <Grid x:Name="TopInterface" Grid.Row="1" Grid.ColumnSpan="2">
            <TextBlock Text="Этаж: " FontSize="15" HorizontalAlignment="Left"/>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="HP " />
                <ProgressBar x:Name="HPProgressBar" Maximum="100" Minimum="0" Value="100" Height="15" Foreground="Red" />
                <TextBlock x:Name="HP" Text="{Binding HP}"></TextBlock>
            </StackPanel>
        </Grid>

        <Frame Grid.Row="2" Grid.ColumnSpan="2">
            
        </Frame>
        
        
        <Grid Grid.Row="3" >
            <TextBlock HorizontalAlignment="Left" Text="Броня: " FontSize="22" VerticalAlignment="Center"></TextBlock>
            <TextBlock HorizontalAlignment="Right" Text="Оружие: " FontSize="22" VerticalAlignment="Center"></TextBlock>
        </Grid>
        
        
        <ListView Grid.Row="3" Grid.Column="1">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Person1}" />
                        <TextBlock Text=" получает "/>
                        <TextBlock  Text="{Binding TakeDamage }" />
                        <TextBlock Text=" урона "/>

                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
