<Page x:Class="ISIP323_Anisimov_WPF.Pages.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Anisimov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page1"  Background="#FFA9A8A8">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="33*"/>
            <ColumnDefinition Width="33*"/>
            <ColumnDefinition Width="33*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        
        
        <StackPanel Grid.Column="0">
            <Image x:Name="Product1Image"/>
            <TextBlock Text="Товар" x:Name="Product1Name"/>
            <TextBlock Text="Цена" x:Name="Product1Price"/>
            <Button Content="Добавить" x:Name="Product1ButtonAdd" Click="Product1ButtonAdd_Click"/>
        </StackPanel>


        <StackPanel Grid.Column="1">
            <Image x:Name="Product2Image"/>
            <TextBlock Text="Товар" x:Name="Product2Name"/>
            <TextBlock Text="Цена" x:Name="Product2Price"/>
            <Button Content="Добавить" x:Name="Product2ButtonAdd" Click="Product2ButtonAdd_Click"/>
        </StackPanel>


        <StackPanel Grid.Column="2">
            <Image x:Name="Product3Image"/>
            <TextBlock Text="Товар" x:Name="Product3Name"/>
            <TextBlock Text="Цена" x:Name="Product3Price"/>
            <Button Content="Добавить" x:Name="Product3ButtonAdd" Click="Product3ButtonAdd_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Center">
            <Button Content="Перейти к заказу" x:Name="Page2Button" Click="Page2Button_Click"/>
        </StackPanel>
        
        
    </Grid>
</Page>
