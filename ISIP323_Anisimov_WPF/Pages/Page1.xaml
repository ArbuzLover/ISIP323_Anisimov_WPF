<Page x:Class="ISIP323_Anisimov_WPF.Pages.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Anisimov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page1"  Background="#FFA9A8A8">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="33*"/>
            <ColumnDefinition Width="33*"/>
            <ColumnDefinition Width="33*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>
        
        
        
        
            <Image x:Name="Product1Image" />
        <StackPanel Grid.Column="0" Grid.Row="1" >
            <TextBlock Text="Товар" x:Name="Product1Name" HorizontalAlignment="Center"/>
            <TextBlock Text="Цена" x:Name="Product1Price" HorizontalAlignment="Center"/>
            <Button Content="Добавить" x:Name="Product1ButtonAdd" Click="Product1ButtonAdd_Click" Grid.Row="1"/>
        </StackPanel>


            
            <Image x:Name="Product2Image" Grid.Column="1"/>
        <StackPanel Grid.Column="1" Grid.Row="1">
            <TextBlock Text="Товар" x:Name="Product2Name" HorizontalAlignment="Center"/>
            <TextBlock Text="Цена" x:Name="Product2Price" HorizontalAlignment="Center"/>
            <Button Content="Добавить" x:Name="Product2ButtonAdd" Click="Product2ButtonAdd_Click" Grid.Row="1"/>
        </StackPanel>


        
            <Image x:Name="Product3Image"   Grid.Column="2" />
        <StackPanel Grid.Column="2" Grid.Row="1">
            <TextBlock Text="Товар" x:Name="Product3Name" HorizontalAlignment="Center"/>
            <TextBlock Text="Цена" x:Name="Product3Price" HorizontalAlignment="Center"/>
            <Button Content="Добавить" x:Name="Product3ButtonAdd" Click="Product3ButtonAdd_Click" />
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20">
            <Button Content="Перейти к заказу" x:Name="Page2Button" Click="Page2Button_Click"/>
        </StackPanel>
        
        
    </Grid>
</Page>
