<Page x:Class="ISIP323_Anisimov_WPF.Pages.FilmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Anisimov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FilmPage" Background="LightCyan">

    <Grid>
        

                    <StackPanel>
                        <Image  Width="300" Height="300" Source="{Binding ImagePath}"/>

                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Description}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Genres.Name}" HorizontalAlignment="Center"/> <!-- ХЗ НЕ РАБОТАЕТ ПОКА ЧТО-->
            <TextBlock  Text="{Binding RateFilm}" HorizontalAlignment="Center"/>
            <TextBlock  Text="{Binding RateAge.Age}" HorizontalAlignment="Center"/>
                    </StackPanel>

                
    </Grid>
</Page>
