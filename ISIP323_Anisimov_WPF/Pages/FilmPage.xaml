<Page x:Class="ISIP323_Anisimov_WPF.Pages.FilmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Anisimov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FilmPage" Background="LightCyan">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <Image  Width="300" Height="300" Source="{Binding ChooseFilm.ImagePath}"/>

            <TextBlock Text="{Binding ChooseFilm.Name}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding ChooseFilm.Description}" HorizontalAlignment="Center"/>
            <ListBox x:Name="GenresListBox" Width="200" ItemsSource="{Binding  ChooseFilm.Genres}" IsEnabled="False">

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock  Text="{Binding ChooseFilm.RateFilm}" HorizontalAlignment="Center"/>
            <TextBlock  Text="{Binding ChooseFilm.RateAge.Age}" HorizontalAlignment="Center"/>
        </StackPanel>



        <StackPanel Grid.Column="1">
            <ListBox x:Name="SessionsListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="1" SelectionChanged="SessionsListBox_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="{Binding DateTime}" HorizontalAlignment="Center"/>
                            <TextBlock  Text="{Binding Halls.Name}" HorizontalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBlock  Text="{Binding Halls.RateHall.Type}" HorizontalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Page>
