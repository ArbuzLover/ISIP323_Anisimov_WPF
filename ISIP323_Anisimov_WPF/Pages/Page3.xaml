<Page x:Class="ISIP323_Anisimov_WPF.Pages.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Anisimov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page3" Background="#FFA9A8A8">

    <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="Имя клиента:"/>
        <TextBox HorizontalAlignment="Left" x:Name="NameUser" Width="100" TextChanged="NameUser_TextChanged"/>
        <TextBlock Text="Почта:"/>
        <TextBox HorizontalAlignment="Left" x:Name="EmailUser" Width="100" TextChanged="EmailUser_TextChanged"/>
        <TextBlock Text="Адрес :"/>
        <TextBox HorizontalAlignment="Left" x:Name="AddresUser" Width="100" TextChanged="AddresUser_TextChanged"/>
        <ListBox x:Name="Zakaz" IsEnabled="False">
            <TextBlock>Ваш заказ:</TextBlock>
            <TextBlock Text="Товар 1" x:Name="Product1"/>
            <TextBlock Text="Товар 2" x:Name="Product2"/>
            <TextBlock Text="Товар 3"  x:Name="Product3"/>
            <TextBlock x:Name="Itog">Итого: </TextBlock>
        </ListBox>
        <Button Content="Оформить заказ" Click="Button_Click"/>
    </StackPanel>
</Page>
