<Page x:Class="ISIP323_Anisimov_WPF.Pages.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Anisimov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page2" Background="#FFA9A8A8">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <ListBox x:Name="BasketListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Height="300" Width="200">
            

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Price}" HorizontalAlignment="Center"/>


                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="Перейти к оформлению" x:Name="Page3Button" Click="Page3Button_Click" />
    </StackPanel>
</Page>
