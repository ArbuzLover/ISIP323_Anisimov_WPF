<Page x:Class="ISIP323_Anisimov_WPF.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Anisimov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage" Background="LightCyan">

    <Grid>

        
        <!-- main -->
        <Border Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" BorderThickness="1" BorderBrush="Black" Width="400" Height="350">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="LoginButton" Grid.Column="0" FontSize="15" Content="Войти" Width="150" Height="30"  Background="Transparent" BorderBrush="Transparent"/>
                        <Button x:Name="RegisterButton" Grid.Column="1" FontSize="15"  Content="Зарегистрироваться"  Width="150" Height="30"  Background="Transparent" BorderBrush="Transparent" Click="RegisterButton_Click"/>
                    </Grid>
                </StackPanel>
                <StackPanel Margin="5,5,5,5" VerticalAlignment="Center" Grid.Row="1">
                    <TextBlock Text="Введите логин" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBox x:Name="UserLogin" Padding="8,10" Height="38"/>
                    <TextBlock Text="Введите пароль" FontSize="20"  HorizontalAlignment="Center"/>
                    <TextBox x:Name="UserPassword" Padding="8,10" Height="38"/>
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Bottom">

                    <Button Grid.Row="1" Width="150" x:Name="InputButton" Click="InputButton_Click" Content="Войти" FontSize="15" Background="Transparent"  Margin="5,5,5,10"  VerticalAlignment="Bottom"/>
                    
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
