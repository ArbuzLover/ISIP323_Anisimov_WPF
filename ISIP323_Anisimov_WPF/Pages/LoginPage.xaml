<Page x:Class="ISIP323_Anisimov_WPF.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Anisimov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <StackPanel>
        <Button Content="Назад" Click="Back_Click"
                HorizontalAlignment="Left" FontSize="20"
                Margin="5" Height="40" Width="100"/>

        <TextBlock Text="Вход" FontSize="24" Margin="10"
                   HorizontalAlignment="Left"/>

        <TextBlock Text="Логин:" Margin="5"
                   FontSize="20" HorizontalAlignment="Left"/>
        <TextBox x:Name="LoginBox" Margin="5"
                 HorizontalAlignment="Left"
                 Height="40" Width="200"/>

        <TextBlock Text="Пароль:" Margin="5"
                   FontSize="20" HorizontalAlignment="Left"/>
        <PasswordBox x:Name="PasswordBox" Margin="5"
                     HorizontalAlignment="Left"
                     Height="40" Width="200"/>

        <Button Content="Войти" Height="35" Width="Auto"
                Click="Login_Click" Margin="5" 
                HorizontalAlignment="Left" FontSize="20"/>

        <TextBlock Text="Нет аккаунта?" HorizontalAlignment="Left" Margin="5,20,0,5"/>
        <Button Content="Зарегистрироваться" Click="ToRegisterPage_Click"
                Margin="5" Height="45" Width="Auto"
                HorizontalAlignment="Left" FontSize="20"/>

        <TextBlock x:Name="MessageText" Foreground="Black" TextWrapping="Wrap" Margin="5"/>
    </StackPanel>
</Page>
